# Server-side secrets for the "ai" function. Local: copy to supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env

# Provider: openrouter (default) | gigachat | anthropic
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=paste-the-sk-or-key-from-openrouter.ai/keys
# Optional
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,thinkingmachines/inkling:free,nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_MODEL_CHAT=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_EVALUATE=google/gemma-4-31b-it:free
# OPENROUTER_MODEL_TOPIC=google/gemma-4-31b-it:free
# OPENROUTER_REASONING=low

# Alternative provider: gigachat
# AI_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=paste-the-Authorization-key-from-developers.sber.ru
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL_CHAT=GigaChat-2-Max
# GIGACHAT_MODEL_EVALUATE=GigaChat-2-Max
# GIGACHAT_MODEL_TOPIC=GigaChat-2-Pro
# GIGACHAT_STRUCTURED=off

# Alternative provider: anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5-5

AI_DAILY_LIMIT=20
ALLOWED_ORIGINS=https://xamad558-gif.github.io,capacitor://localhost,https://localhost
