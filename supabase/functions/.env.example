# Server-side secrets for the "ai" function. Local: copy to supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=60
ALLOWED_ORIGINS=capacitor://localhost,https://localhost
